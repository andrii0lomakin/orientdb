  <artifactId>youtrackdb-core</artifactId>
  <name>YouTrackDB Core</name>

  <properties>
    <jna.version>4.0.0</jna.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.clean.plugin.version>3.5.0</maven.clean.plugin.version>
    <generated.antlr.dir>${project.build.directory}/generated-sources/antlr</generated.antlr.dir>
    <gql.antlr.package>com.jetbrains.youtrackdb.internal.core.gql.parser.gen</gql.antlr.package>
    <gql.antlr.output.dir>
      ${generated.antlr.dir}/com/jetbrains/youtrackdb/internal/core/gql/parser/gen
    </gql.antlr.output.dir>
    <!--This property is updated automatically and is needed to make build reproducible-->
    <project.build.outputTimestamp>2023-01-01T00:00:00Z</project.build.outputTimestamp>
    <argLine>-ea
      -Xms${heapSize}
      -Xmx${heapSize}
      -Dyoutrackdb.storage.diskCache.bufferSize=4096
      -Dindex.flushAfterCreate=false
      -Dyoutrackdb.storage.makeFullCheckpointAfterCreate=false
