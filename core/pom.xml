  <profiles>
    <profile>
      <id>docker-run</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>buildnumber-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>build-number</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Run the Records GC stress test via exec:exec (no surefire).
         Single command:
           ./mvnw -pl core -am verify -P stress-test -DskipTests
         Override duration (30 min, 10s windows):
           ./mvnw -pl core -am verify -P stress-test -DskipTests -DstressArgs="30 10" -->
    <profile>
      <id>stress-test</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>build-test-classpath</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>build-classpath</goal>
                </goals>
                <configuration>
                  <outputProperty>stress.classpath</outputProperty>
                  <includeScope>test</includeScope>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>run-stress-test</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <executable>/bin/sh</executable>
              <arguments>
                <argument>-c</argument>
                <argument>exec java -Xms4g -Xmx4g --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.util.concurrent=ALL-UNNAMED --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED --add-opens=java.base/java.net=ALL-UNNAMED --add-opens=jdk.unsupported/sun.misc=ALL-UNNAMED -classpath "${project.build.testOutputDirectory}:${project.build.outputDirectory}:${stress.classpath}" com.jetbrains.youtrackdb.internal.core.storage.collection.v2.RecordsGcStressTest ${stressArgs}</argument>
              </arguments>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Run StorageComponent integration tests with a small disk cache (4 MB)
         to exercise optimistic read fallback under heavy eviction pressure.
         Command: ./mvnw -pl core -am clean verify -P small-cache-it -->
    <profile>
      <id>small-cache-it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <skipTests>true</skipTests>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <youtrackdb.storage.diskCache.bufferSize>4
                </youtrackdb.storage.diskCache.bufferSize>
                <youtrackdb.test.env>ci</youtrackdb.test.env>
                <!-- Reduce BTree dataset sizes for fast eviction testing -->
                <youtrackdb.test.btree.keysCount>10000
                </youtrackdb.test.btree.keysCount>
                <youtrackdb.test.btree.maxPower>14
                </youtrackdb.test.btree.maxPower>
              </systemPropertyVariables>
              <includes>
                <include>**/index/sbtree/singlevalue/v3/BTreeTestIT.java</include>
                <include>**/index/edgebtree/btree/BTreeTestIT.java</include>
                <include>**/collection/v2/LocalPaginatedCollectionV2TestIT.java</include>
                <!-- FreeSpaceMapTestIT: included for completeness; its small page
                     count does not trigger eviction, so it tests correctness only. -->
                <include>**/collection/v2/FreeSpaceMapTestIT.java</include>
              </includes>
            </configuration>
            <executions>
              <!-- The parent POM declares an inherited maven-failsafe-plugin execution.
                   This profile declares its own execution, named small-cache-integration-test.
                   The inherited execution is disabled here, so exactly one execution runs.
                   Without that disabling, both executions would carry the same configuration.
                   The maven-failsafe-plugin would then run only the first execution.
                   A future configuration difference would make both executions run.
                   Both executions write the same report file names.
                   One report would then overwrite the other. -->
              <execution>
                <id>default</id>
                <phase>none</phase>
              </execution>
              <execution>
                <id>small-cache-integration-test</id>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Compliance executions: one per TinkerPop suite-wrapper class (YTDBProcessTest,
      YTDBStandardOrderSemanticsProcessTest, YTDBStructureTest, YTDBGraphFeatureTest,
      YTDBStandardOrderSemanticsFeatureTest). Each wrapper carries
      @Category(SequentialTest.class), but running it under any execution that configures a
      <groups>/<excludedGroups> filter (like sequential-tests above) silently executes ZERO
      tests: GroupMatcherCategoryFilter resolves @Category per leaf Description, not per class,
      and neither the wrapped upstream TinkerPop test classes (loaded from the gremlin-test JAR)
      nor the Cucumber-synthesized scenario Descriptions carry the category annotation on their
      own Description. Every leaf gets pruned, the suite reports success, and nothing actually
      ran. The fix is to give each wrapper its own execution with NO group filter configured at
      all (neither <groups> nor <excludedGroups>): with no filter, surefire never builds a
      runtime category filter, so no leaf is pruned. Do NOT "helpfully" re-add a <groups> or
      <excludedGroups> filter to these executions later; it will silently bring back the
      zero-tests bug. Each wrapper gets its own execution (rather than one execution listing all
      five) so that <failIfNoTests>true</failIfNoTests> is scoped per wrapper: if any single
      suite ever regresses to zero tests again, its own execution fails the build instead of
      being masked by the others still reporting tests. It also gives each suite its own
      fork, which is the configuration that was performance-measured.

      These five executions live in two profiles of their own, activated on the ABSENCE of the
      `test` user property, rather than as bare executions on the maven-surefire-plugin
      declaration below. Reason: surefire discards EVERY execution's configured
      includes/excludes the moment -Dtest= is supplied on the command line
      (AbstractSurefireMojo#isSpecificTestSpecified() in the surefire sources); each execution
      then tries to run whatever -Dtest= names instead of its own includes. Left as bare
      executions that would mean: (a) an ordinary `-Dtest=SomeTest` core build runs SomeTest
      in six forks instead of one, once per
      compliance execution plus whichever execution it would normally belong to; and (b) a
      `-Dtest=SomeUnrelatedTest` build that matches nothing in this module hard-fails here
      anyway, via failIfNoSpecifiedTests (default true): once -Dtest= is set,
      AbstractSurefireMojo#getEffectiveFailIfNoTests() consults only that flag, never
      failIfNoTests, so the <failIfNoTests>true</failIfNoTests> below is not what triggers it.
      The -Dtest= builds run by .github/workflows/ci-failure-fix-agent.yml are real instances of
      this pattern. Deactivating both profiles whenever -Dtest is supplied removes these
      executions from the reactor entirely for such runs, restoring the pre-existing -Dtest=
      behavior, while an ordinary build (no -Dtest) still activates both profiles and runs all
      five suites with their failIfNoTests guard intact.

      The executions are spread over two profiles, split roughly by cost, so that the nightly
      Windows legs can run them in separate jobs — see the shard-skip-core-unit-tests profile
      below for why that split exists. Both profiles carry the same `!test` activation, so
      every build that is not a -Dtest= build activates both and the five executions run
      together exactly as they did when one profile held all of them. A new compliance
      execution belongs in whichever of the two profiles keeps the measured cost closer to
      even; adding it to either one puts it in exactly one nightly shard automatically.
    -->
    <profile>
      <id>gremlin-compliance-process-suites</id>
      <activation>
        <property>
          <name>!test</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>gremlin-process-compliance-tests</id>
                <phase>test</phase>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>**/YTDBProcessTest.java</include>
                  </includes>
                  <failIfNoTests>true</failIfNoTests>
                </configuration>
              </execution>
              <execution>
                <id>gremlin-standard-order-process-compliance-tests</id>
                <phase>test</phase>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>**/YTDBStandardOrderSemanticsProcessTest.java</include>
                  </includes>
                  <failIfNoTests>true</failIfNoTests>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>gremlin-compliance-structure-suites</id>
      <activation>
        <property>
          <name>!test</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>gremlin-structure-compliance-tests</id>
                <phase>test</phase>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>**/YTDBStructureTest.java</include>
                  </includes>
                  <failIfNoTests>true</failIfNoTests>
                </configuration>
              </execution>
              <execution>
                <id>gremlin-feature-compliance-tests</id>
                <phase>test</phase>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>**/YTDBGraphFeatureTest.java</include>
                  </includes>
                  <systemPropertyVariables>
                    <youtrackdb.test.gremlin.orderSemantics>default</youtrackdb.test.gremlin.orderSemantics>
                  </systemPropertyVariables>
                  <failIfNoTests>true</failIfNoTests>
                </configuration>
              </execution>
              <execution>
                <id>gremlin-standard-order-feature-compliance-tests</id>
                <phase>test</phase>
                <goals>
                  <goal>test</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>**/YTDBStandardOrderSemanticsFeatureTest.java</include>
                  </includes>
                  <systemPropertyVariables>
                    <youtrackdb.test.gremlin.orderSemantics>standard</youtrackdb.test.gremlin.orderSemantics>
                  </systemPropertyVariables>
                  <failIfNoTests>true</failIfNoTests>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Nightly Windows shard support. This module's test phase no longer fits inside GitHub's
      unraisable 360-minute cap on a hosted Windows runner, so
      .github/workflows/maven-integration-tests-pipeline.yml splits that leg into several jobs
      along this module's surefire executions. The shard comment in that file is the canonical
      account of why, and carries the measurements. This profile is how a shard that runs only
      the compliance suites drops the rest of this module's tests.

      Activating it rebinds default-test and sequential-tests to phase `none`, which unbinds
      them: both executions stay declared, but no lifecycle phase invokes them. The
      small-cache-it profile above unbinds the inherited failsafe execution the same way. A
      shard drops the compliance suites instead by deactivating
      gremlin-compliance-process-suites or gremlin-compliance-structure-suites with
      `-P '!<profile-id>'`, which needs nothing declared here.

      Unbinding is the deliberate choice here; -Dtest= and -Dsurefire.includesFile are not
      used. Both replace every execution's own includes — see the note above the compliance
      profiles for what that does to this module — and -Dtest= additionally deactivates those
      profiles, dropping all five compliance suites from the build without a word. Unbinding
      changes only which executions the lifecycle invokes; every execution that still runs
      keeps the configuration it has in an ordinary build.

      The split is exhaustive because default-test and sequential-tests both exclude
      **/gremlintest/**, where all five compliance wrapper classes live, so the unit and
      compliance sides share no test class. Unbinding works by execution id, so a surefire
      execution added to this module's <build> in future would NOT be unbound here and would
      run in every shard rather than none: the split errs towards running a test twice, never
      towards dropping it.

      <skipTests> is not the alternative it looks like either. Set at plugin level it
      silences every execution of that plugin at once, so it cannot express "unit executions
      off, compliance executions on", which is the whole point of a shard. Set per execution
      it could express that, but it works by merging configuration into an execution that
      still runs, where phase-unbinding removes the execution from the lifecycle outright and
      matches what small-cache-it above already does. -Dmaven.test.skip would express even
      less: it also stops test-compile, and the tests module depends on this module's test
      classes, so they must be compiled in every shard.

      Only .github/workflows/maven-integration-tests-pipeline.yml sets the property, so an
      ordinary build is unaffected. The profile sets no <skipTests>, so -DskipTests keeps
      working exactly as before.
    -->
    <profile>
      <id>shard-skip-core-unit-tests</id>
      <activation>
        <property>
          <name>youtrackdb.shard.skipCoreUnitTests</name>
          <!-- Matched on the value, not merely on the property being present. Presence-only
               activation would make -Dyoutrackdb.shard.skipCoreUnitTests=false skip the tests,
               and it reads JVM system properties too, so MAVEN_OPTS or .mvn/jvm.config would
               activate it as readily as this workflow's -D does. -->
          <value>true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>default-test</id>
                <phase>none</phase>
              </execution>
              <execution>
                <id>sequential-tests</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
          <!-- vmlens is the module's second test-running plugin: its `test` execution takes
               the goal's default `test` phase and runs **/*MTTest.java under an interleaving
               agent. Unbinding surefire alone left those three classes running in all four
               shards, which the shard logs confirmed, so it is unbound here too and the
               instrumented run happens once, in the core-unit shard. -->
          <plugin>
            <groupId>com.vmlens</groupId>
            <artifactId>vmlens-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>test</id>
                <phase>none</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>


  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>buildnumber-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>build-number</id>
            <phase>validate</phase>
            <goals>
              <goal>create</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>javacc-maven-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>jjtree-javacc</id>
            <goals>
              <goal>jjtree-javacc</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <sourceDirectory>${basedir}/src/main/grammar</sourceDirectory>
          <interimDirectory>${basedir}/src/main/java</interimDirectory>
          <outputDirectory>${basedir}/src/main/java</outputDirectory>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.antlr</groupId>
        <artifactId>antlr4-maven-plugin</artifactId>
        <version>${antlr.version}</version>
        <executions>
          <execution>
            <id>generate-antlr</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>antlr4</goal>
            </goals>
            <configuration>
              <sourceDirectory>${basedir}/src/main/grammar/antlr</sourceDirectory>
              <outputDirectory>${gql.antlr.output.dir}</outputDirectory>
              <visitor>true</visitor>
              <listener>true</listener>
              <treatWarningsAsErrors>true</treatWarningsAsErrors>
              <arguments>
                <argument>-package</argument>
                <argument>${gql.antlr.package}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
       <plugin>
        <artifactId>maven-clean-plugin</artifactId>
        <version>${maven.clean.plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-junit47</artifactId>
            <version>${surefire.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <systemPropertyVariables>
            <buildDirectory>${project.build.directory}</buildDirectory>
            <build.dir>${project.build.directory}</build.dir>
          </systemPropertyVariables>
          <properties>
            <property>
              <name>listener</name>
              <value>com.jetbrains.youtrackdb.internal.JUnitTestListener</value>
            </property>
          </properties>
        </configuration>
        <executions>
          <!--
            Parallel execution: runs all project tests EXCEPT @Category(SequentialTest).
            Excludes gremlin-test from classpath to prevent TinkerPop dependency tests
            from being discovered (they require suite runners to set up the graph provider).
          -->
          <execution>
            <id>default-test</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <parallel>classes</parallel>
              <perCoreThreadCount>false</perCoreThreadCount>
              <threadCountClasses>4</threadCountClasses>
              <excludedGroups>com.jetbrains.youtrackdb.internal.SequentialTest</excludedGroups>
              <excludes>
                <exclude>**/gremlintest/**</exclude>
              </excludes>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>io.youtrackdb:gremlin-test</classpathDependencyExclude>
              </classpathDependencyExcludes>
            </configuration>
          </execution>
          <!--
            Sequential execution: runs only @Category(SequentialTest) tests.
            This includes tests that mutate GlobalConfiguration, use shared static
            instances, manipulate engine singletons, or run heavyweight TinkerPop
            suite runners with shared datasets.
          -->
          <execution>
            <id>sequential-tests</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <groups>com.jetbrains.youtrackdb.internal.SequentialTest</groups>
              <excludes>
                <!-- The five TinkerPop compliance wrapper classes (YTDBProcessTest,
                     YTDBStandardOrderSemanticsProcessTest, YTDBStructureTest,
                     YTDBGraphFeatureTest, YTDBStandardOrderSemanticsFeatureTest) live under
                     gremlintest/**, and so do the roughly nine YTDB-authored scenario/suite
                     classes they invoke via reflection (packages gremlintest.scenarios /
                     gremlintest.suites). The other
                     ~3,700-3,800 classes those wrappers exercise are upstream TinkerPop
                     compliance classes loaded from the gremlin-test JAR dependency; they are
                     never file-scanned from this project's own test-classes directory, so this
                     file-glob exclude cannot see them and they were never at risk of the bug
                     below. It's specifically the ~9 YTDB scenario/suite classes that ARE at
                     risk: each one is independently file-scanned here too (they are ordinary
                     compiled classes under gremlintest/**) AND carries the SequentialTest
                     category on its own Description (via extending YTDBAbstractGremlinTest,
                     which is annotated with it), so GroupMatcherCategoryFilter would match them
                     a second time under this execution's <groups> filter, on top of the single
                     run they already get via the gremlin-*-compliance-tests executions (see the
                     gremlin-compliance-process-suites and gremlin-compliance-structure-suites
                     profiles below). -->
                <exclude>**/gremlintest/**</exclude>
                <!-- Configuring ANY custom <excludes> here replaces surefire's default
                     excludes outright, silently disabling its built-in exclusion of
                     nested/inner classes (**/*$*.java). Restore that default explicitly so
                     inner classes are not picked up as top-level test classes. -->
                <exclude>**/*$*</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-junit47</artifactId>
            <version>${surefire.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <systemPropertyVariables>
            <buildDirectory>${project.build.directory}</buildDirectory>
          </systemPropertyVariables>
          <properties>
            <property>
              <name>listener</name>
              <value>com.jetbrains.youtrackdb.internal.JUnitTestListener</value>
            </property>
          </properties>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
          </archive>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-generated-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${generated.antlr.dir}</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-antlr-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${generated.antlr.dir}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <encoding>${project.build.sourceEncoding}</encoding>
          <useIncrementalCompilation>true</useIncrementalCompilation>
          <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
          <annotationProcessors>
            <annotationProcessor>
              com.jetbrains.youtrackdb.internal.annotations.gremlin.dsl.GremlinDslProcessor
            </annotationProcessor>
          </annotationProcessors>
          <compilerArgs>
            <arg>-parameters</arg>
            <arg>-Agremlin.dsl.sourceDir=${project.basedir}/src/main/java</arg>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
            <arg>${errorprone.args}</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${errorprone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
            <path>
              <groupId>io.youtrackdb</groupId>
              <artifactId>youtrackdb-gremlin-annotations</artifactId>
              <version>${project.version}</version>
            </path>
            <path>
              <groupId>org.openjdk.jmh</groupId>
              <artifactId>jmh-generator-annprocess</artifactId>
              <version>1.37</version>
            </path>
            <path>
              <groupId>org.slf4j</groupId>
              <artifactId>slf4j-nop</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
        <executions>
          <execution>
            <id>test-compile</id>
            <phase>test-compile</phase>
            <goals>
              <goal>testCompile</goal>
            </goals>
            <configuration>
              <annotationProcessors>
                <annotationProcessor>
                  org.openjdk.jmh.generators.BenchmarkProcessor
                </annotationProcessor>
              </annotationProcessors>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.vmlens</groupId>
        <artifactId>vmlens-maven-plugin</artifactId>
        <version>1.2.28</version>
        <executions>
          <execution>
            <id>test</id>
            <goals>
              <goal>test</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <includes>
            <include>**/*MTTest.java</include>
          </includes>
          <!-- When -Dtest=SomeTest is passed for a non-MT test,
               don't fail because it doesn't match *MTTest.java -->
          <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
          <failIfNoTests>false</failIfNoTests>
        </configuration>
      </plugin>
    </plugins>
  </build>

